{
  "business_rule_system": {
    "project_name": "奇境-小龙项目",
    "system_version": "1.0.0",
    "created_date": "2025-11-13",
    "description": "深度理解客户案例中的修改逻辑和业务要求，实现规则复刻和快速执行",
    "status": "active"
  },
  "rule_understanding_framework": {
    "modification_pattern_analyzer": {
      "purpose": "分析客户修改要求背后的逻辑和动机",
      "analysis_dimensions": [
        {
          "dimension": "设计风格变化",
          "focus": "颜色、布局、字体、视觉元素的变化模式",
          "extraction_targets": [
            "颜色偏好趋势",
            "布局习惯模式",
            "字体选择规律",
            "视觉元素组合偏好"
          ]
        },
        {
          "dimension": "品牌规范调整",
          "focus": "品牌标识使用、色彩规范、字体规范的调整",
          "extraction_targets": [
            "品牌标识使用频率",
            "品牌色彩应用范围",
            "品牌字体使用场景",
            "品牌一致性要求"
          ]
        },
        {
          "dimension": "用户体验优化",
          "focus": "交互流程、信息架构、视觉层次改进",
          "extraction_targets": [
            "用户操作路径优化",
            "信息组织方式偏好",
            "视觉重点设置规律",
            "交互复杂度要求"
          ]
        },
        {
          "dimension": "业务目标驱动",
          "focus": "转化率、品牌传播、用户体验指标",
          "extraction_targets": [
            "转化率优化策略",
            "品牌传播重点",
            "用户满意度指标",
            "商业价值实现方式"
          ]
        }
      ]
    },
    "requirement_inference_engine": {
      "purpose": "从具体修改中推断通用要求和偏好",
      "inference_methods": [
        {
          "method": "模式识别",
          "description": "识别重复出现的修改模式和偏好",
          "algorithm": "pattern_mining_with_confidence_scoring",
          "output": "修改模式规则库"
        },
        {
          "method": "因果分析",
          "description": "分析修改原因和效果的因果关系",
          "algorithm": "causal_relationship_analysis",
          "output": "因果关系图谱"
        },
        {
          "method": "偏好学习",
          "description": "从历史修改中学习客户偏好",
          "algorithm": "preference_learning_model",
          "output": "客户偏好画像"
        },
        {
          "method": "约束提取",
          "description": "提取业务和设计的约束条件",
          "algorithm": "constraint_extraction_system",
          "output": "约束条件集合"
        }
      ]
    },
    "official_guidance_decoder": {
      "purpose": "理解官方指导、标准和要求背后的逻辑原理",
      "decoding_layers": [
        {
          "layer": "政策驱动因素",
          "analysis": "分析政策法规对设计要求的驱动作用",
          "extraction": "政策合规性要求"
        },
        {
          "layer": "行业标准要求",
          "analysis": "理解行业标准对设计规范的约束",
          "extraction": "行业标准应用规则"
        },
        {
          "layer": "最佳实践指导",
          "analysis": "从成功案例中提取最佳实践原则",
          "extraction": "最佳实践应用指南"
        },
        {
          "layer": "技术实现约束",
          "analysis": "分析技术可行性对设计方案的约束",
          "extraction": "技术实现边界条件"
        }
      ]
    }
  },
  "rule_replication_mechanism": {
    "rule_standardization_process": {
      "step_1_case_analysis": {
        "purpose": "深入分析具体案例的修改过程",
        "activities": [
          "收集完整的修改历史记录",
          "分析每次修改的前后对比",
          "识别修改的触发条件",
          "记录修改的效果评估"
        ],
        "output": "案例分析报告"
      },
      "step_2_pattern_extraction": {
        "purpose": "从案例分析中提取可重复的模式",
        "activities": [
          "识别重复出现的修改类型",
          "归纳修改的共同特征",
          "分析修改的成功因素",
          "总结修改的失败教训"
        ],
        "output": "修改模式集合"
      },
      "step_3_rule_abstraction": {
        "purpose": "将具体模式抽象为通用规则",
        "activities": [
          "去除案例特定的细节",
          "提炼通用的指导原则",
          "定义规则的适用条件",
          "建立规则的验证标准"
        ],
        "output": "抽象化规则库"
      },
      "step_4_generalization_validation": {
        "purpose": "验证规则的通用性和有效性",
        "activities": [
          "在不同案例中测试规则",
          "评估规则的适用范围",
          "优化规则的精确度",
          "确认规则的实用性"
        ],
        "output": "验证通过的规则"
      }
    },
    "knowledge_transfer_system": {
      "similarity_matching_engine": {
        "purpose": "快速匹配新任务与已知规则的相似度",
        "matching_criteria": [
          {
            "criteria": "业务类型相似性",
            "weight": 0.30,
            "description": "业务领域的相似程度"
          },
          {
            "criteria": "设计要求相似性",
            "weight": 0.25,
            "description": "设计需求的相似程度"
          },
          {
            "criteria": "约束条件相似性",
            "weight": 0.20,
            "description": "约束条件的相似程度"
          },
          {
            "criteria": "目标指标相似性",
            "weight": 0.15,
            "description": "业务目标的相似程度"
          },
          {
            "criteria": "技术实现相似性",
            "weight": 0.10,
            "description": "技术实现的相似程度"
          }
        ],
        "matching_threshold": 0.70,
        "max_candidates": 5
      },
      "context_adaptation_engine": {
        "purpose": "根据具体上下文调整通用规则",
        "adaptation_dimensions": [
          {
            "dimension": "客户特定要求",
            "adaptation_method": "rule_customization"
          },
          {
            "dimension": "项目约束条件",
            "adaptation_method": "constraint_adjustment"
          },
          {
            "dimension": "技术实现环境",
            "adaptation_method": "technical_optimization"
          },
          {
            "dimension": "时间预算限制",
            "adaptation_method": "scope_prioritization"
          }
        ]
      },
      "rule_application_system": {
        "purpose": "将适配后的规则应用到具体任务",
        "application_process": [
          "规则预处理和格式化",
          "与任务上下文的对齐",
          "规则优先级排序",
          "分步骤应用执行"
        ]
      },
      "effectiveness_validation": {
        "purpose": "验证规则应用的效果和价值",
        "validation_metrics": [
          "规则应用完整度",
          "预期效果达成度",
          "客户满意度预期",
          "实施效率提升度"
        ]
      }
    }
  },
  "customer_case_analysis": {
    "xilimen_case": {
