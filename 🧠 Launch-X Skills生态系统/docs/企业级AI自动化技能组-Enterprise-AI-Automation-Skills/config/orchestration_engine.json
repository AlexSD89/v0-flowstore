          "sync_frequencies": {
            "project_status": "real_time",
            "resource_allocation": "30_seconds",
            "risk_metrics": "1_minute",
            "progress_updates": "5_minutes"
          }
        },
        "batch_sync": {
          "enabled": true,
          "non_critical_data": [
            "historical_reports",
            "knowledge_updates",
            "analytics_data",
            "user_feedback"
          ],
          "sync_schedules": [
            {"time": "02:00", "frequency": "daily"},
            {"time": "06:00", "frequency": "daily"},
            {"time": "22:00", "frequency": "daily"},
            {"day": "sunday", "time": "03:00", "frequency": "weekly"}
          ]
        }
      }
    },
