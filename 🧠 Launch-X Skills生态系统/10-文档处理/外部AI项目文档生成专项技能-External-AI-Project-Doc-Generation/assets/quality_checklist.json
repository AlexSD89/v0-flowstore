{
  "version": "1.0.0",
  "created_date": "2025-11-18",
  "description": "Automated quality validation checklist for external project analysis",
  "minimum_score_threshold": 85,
  "validation_sections": {
    "structure_completeness": {
      "weight": 0.20,
      "required_items": [
        {
          "id": "frontmatter_completeness",
          "description": "Frontmatter contains all required fields",
          "validation": "required_fields_present",
          "required_fields": ["title", "owners", "status", "last_update", "quality_score"],
          "weight": 1.0
        },
        {
          "id": "six_section_structure",
          "description": "All six required sections are present",
          "validation": "section_count_check",
          "required_sections": [
            "I 项目概览",
            "📊 II. 融资密码解析",
            "🤖 III. AI范式突破点",
            "🚀 IV. LaunchX集成路线图",
            "V. 知识价值判断",
            "📋 VI. 完整数据溯源"
          ],
          "weight": 1.0
        },
        {
          "id": "section_completeness",
          "description": "Each section contains required subsections",
          "validation": "subsection_completeness_check",
          "weight": 1.0
        },
        {
          "id": "emoji_consistency",
          "description": "Section headers use correct emoji consistently",
          "validation": "emoji_pattern_check",
          "required_emojis": ["📊", "🤖", "🚀", "📋"],
          "weight": 0.8
        }
      ]
    },
    "data_quality": {
      "weight": 0.30,
      "required_items": [
        {
          "id": "data_traceability",
          "description": "All conclusions have VI zone data support",
          "validation": "cross_reference_validation",
          "weight": 1.0
        },
        {
          "id": "source_credibility",
          "description": "Data sources have appropriate credibility ratings",
          "validation": "source_weight_validation",
          "minimum_weight": 0.7,
          "weight": 1.0
        },
        {
          "id": "cross_validation",
          "description": "Key data points have multiple independent sources",
          "validation": "multi_source_verification",
          "minimum_sources": 2,
          "weight": 0.8
        },
        {
          "id": "data_completeness",
          "description": "Required data points are present and complete",
          "validation": "required_data_points_check",
          "minimum_completeness": 0.9,
          "weight": 0.9
        }
      ]
    },
    "format_compliance": {
      "weight": 0.25,
      "required_items": [
        {
          "id": "link_restriction",
          "description": "All external links are only in VI zone",
          "validation": "link_location_check",
          "allowed_sections": ["📋 VI. 完整数据溯源"],
          "weight": 1.0
        },
        {
          "id": "table_format",
          "description": "Tables follow standard markdown formatting",
          "validation": "table_structure_check",
          "weight": 0.8
        },
        {
          "id": "citation_format",
          "description": "Citations follow consistent format",
          "validation": "citation_pattern_check",
          "weight": 0.7
        },
        {
          "id": "date_format",
          "description": "Dates use system-generated format",
          "validation": "date_pattern_check",
          "weight": 0.6
        }
      ]
    },
    "content_quality": {
      "weight": 0.15,
      "required_items": [
        {
          "id": "insight_quality",
          "description": "Insights are actionable and specific",
          "validation": "insight_assessment",
          "minimum_quality": 0.8,
          "weight": 1.0
        },
        {
          "id": "logic_consistency",
          "description": "Analysis conclusions logically follow from data",
          "validation": "logical_flow_check",
          "weight": 0.9
        },
        {
          "id": "value_proposition",
          "description": "LaunchX integration value is clearly articulated",
          "validation": "value_proposition_check",
          "weight": 0.8
        }
      ]
    },
    "archive_standards": {
      "weight": 0.10,
      "required_items": [
        {
          "id": "file_path_correctness",
          "description": "File follows correct naming and path convention",
          "validation": "archive_path_validation",
          "weight": 1.0
        },
        {
          "id": "classification_compliance",
          "description": "Project follows correct classification rules",
          "validation": "classification_check",
          "weight": 0.8
        },
        {
          "id": "batch_recording",
          "description": "Batch ID and completion time are recorded",
          "validation": "batch_metadata_check",
          "weight": 0.6
        }
      ]
    },
    "update_workflow_specific": {
      "weight": 0.15,
      "applicable_to": ["update_workflow", "maintenance_workflow"],
      "required_items": [
        {
          "id": "change_documentation",
          "description": "All changes are properly documented with timestamps",
          "validation": "change_log_validation",
          "required_fields": ["update_date", "change_type", "affected_sections", "source_attribution"],
          "weight": 1.0
        },
        {
          "id": "trend_integration",
          "description": "Trend analysis insights are properly integrated",
          "validation": "trend_insight_integration_check",
          "minimum_insights": 3,
          "weight": 0.9
        },
        {
          "id": "version_control",
          "description": "Archive uses proper version control and history",
          "validation": "version_control_validation",
          "required_elements": ["version_number", "change_log", "previous_version_link"],
          "weight": 0.8
        },
        {
          "id": "url_accessibility",
          "description": "All external URLs are checked for accessibility",
          "validation": "url_accessibility_check",
          "minimum_active_rate": 0.8,
          "weight": 0.9
        },
        {
          "id": "data_freshness",
          "description": "Data currency meets freshness requirements",
          "validation": "freshness_validation",
          "maximum_age_days": 180,
          "weight": 0.7
        },
        {
          "id": "credibility_maintenance",
          "description": "Source credibility scores are maintained or improved",
          "validation": "credibility_trend_check",
          "minimum_acceptable_decline": 0.05,
          "weight": 0.8
        }
      ]
    }
  },
  "scoring": {
    "excellent": {
      "min_score": 95,
      "description": "Exceptional quality exceeding standards"
    },
    "good": {
      "min_score": 85,
      "max_score": 94,
      "description": "Meets all minimum quality standards"
    },
    "acceptable": {
      "min_score": 70,
      "max_score": 84,
      "description": "Meets basic requirements with minor issues"
    },
    "requires_revision": {
      "max_score": 69,
      "description": "Significant improvements needed"
    }
  },
  "error_handling": {
    "validation_failures": {
      "structure_missing": "Template structure incomplete - auto-repair attempted",
      "data_insufficient": "Insufficient data quality - mark gaps and continue",
      "format_errors": "Format compliance issues - auto-fix common problems",
      "quality_low": "Low overall score - provide improvement guidance"
    },
    "recovery_strategies": {
      "auto_repair": "Automatically fix common template and format issues",
      "gap_marking": "Mark information gaps and suggest sources",
      "manual_review": "Flag for human review and decision",
      "regeneration": "Regenerate with modified parameters"
    }
  }
}