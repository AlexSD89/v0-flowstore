  "risk_weights": {
    "market": {
      "weight": 0.30,
      "factors": [
        {"name": "竞争风险", "base_score": 8, "multipliers": {"market_concentration_high": 1.2, "growth_low": 1.3}},
        {"name": "需求变化", "base_score": 6, "multipliers": {"cycle_sensitive": 1.4, "discretionary": 1.2}},
        {"name": "技术替代", "base_score": 7, "multipliers": {"tech_intensity_high": 1.3, "innovation_fast": 1.2}}
      ]
    },
    "financial": {
      "weight": 0.30,
      "factors": [
        {"name": "现金流风险", "base_score": 10, "multipliers": {"burn_rate_high": 1.5, "runway_short": 1.3}},
        {"name": "盈利能力", "base_score": 8, "multipliers": {"margin_negative": 1.4, "margin_declining": 1.2}},
        {"name": "融资环境", "base_score": 6, "multipliers": {"market_downturn": 1.3, "stage_early": 1.2}}
      ]
    },
    "operational": {
      "weight": 0.20,
      "factors": [
        {"name": "团队风险", "base_score": 7, "multipliers": {"founder_inexperience": 1.3, "team_small": 1.2}},
        {"name": "技术风险", "base_score": 8, "multipliers": {"tech_unproven": 1.4, "complexity_high": 1.2}},
        {"name": "执行风险", "base_score": 6, "multipliers": {"track_record_short": 1.3, "scaling_challenged": 1.2}}
      ]
    },
    "regulatory": {
      "weight": 0.20,
      "factors": [
        {"name": "合规风险", "base_score": 9, "multipliers": {"regulated_industry": 1.5, "international": 1.2}},
        {"name": "政策变化", "base_score": 7, "multipliers": {"policy_sensitive": 1.4, "government_dependent": 1.3}},
        {"name": "知识产权", "base_score": 5, "multipliers": {"ip_weak": 1.3, "litigation_risk": 1.4}}
      ]
    }
  },

  "scoring_thresholds": {
    "investment_grade": {
      "excellent": {"min_score": 85, "rating": "A+", "color": "#10B981"},
      "good": {"min_score": 75, "rating": "A", "color": "#22C55E"},
      "above_average": {"min_score": 65, "rating": "B+", "color": "#F59E0B"},
      "average": {"min_score": 55, "rating": "B", "color": "#F97316"},
      "below_average": {"min_score": 45, "rating": "C", "color": "#EF4444"},
      "poor": {"min_score": 0, "rating": "D", "color": "#DC2626"}
    },
    "risk_levels": {
      "low": {"max_score": 30, "color": "#10B981", "action": "monitor"},
      "medium": {"max_score": 50, "color": "#F59E0B", "action": "mitigate"},
      "high": {"max_score": 70, "color": "#F97316", "action": "address"},
      "critical": {"max_score": 100, "color": "#DC2626", "action": "urgent"}
    }
  },

  "valuation_methods": {
    "DCF": {
      "enabled": true,
      "weight": 0.4,
      "parameters": {
        "discount_rate": 0.12,
        "terminal_growth": 0.03,
        "projection_years": 5,
        "perpetuity_growth": 0.02
      }
    },
    "comparable_companies": {
      "enabled": true,
      "weight": 0.3,
      "parameters": {
        "min_comparables": 3,
        "preferred_multiples": ["revenue", "ebitda", "pe"],
        "outlier_threshold": 2.0
      }
    },
    "precedent_transactions": {
      "enabled": true,
      "weight": 0.2,
      "parameters": {
        "lookback_period_months": 24,
        "min_transactions": 2,
        "relevance_threshold": 0.7
      }
    },
    "asset_based": {
      "enabled": false,
      "weight": 0.1,
      "parameters": {
        "liquidation_discount": 0.3,
        "intangible_adjustment": 0.2
      }
    }
  },

  "data_sources": {
    "internal": {
      "database_path": "../../🟣 knowledge/04_被投企业数据库",
      "reliability": 0.9,
      "update_frequency": "daily",
      "coverage": "focused_portfolio"
    },
    "public": {
      "sources": ["sec_filings", "company_websites", "press_releases", "industry_reports"],
      "reliability": 0.8,
      "update_frequency": "weekly",
      "coverage": "broad_market"
    },
    "paid": {
      "providers": ["pitchbook", "crunchbase", "pitchbook_data", "cb_insights"],
      "reliability": 0.95,
      "update_frequency": "daily",
      "coverage": "comprehensive"
    },
    "expert": {
      "network": ["industry_experts", "customers", "suppliers", "competitors"],
      "reliability": 0.7,
      "update_frequency": "as_needed",
      "coverage": "targeted_insights"
    }
  },

  "quality_controls": {
    "data_validation": {
      "required_fields": ["name", "industry", "revenue"],
      "data_types": {
        "revenue": "number",
        "growth_rate": "number",
        "employees": "integer",
        "founding_date": "date"
      },
      "value_ranges": {
        "revenue": {"min": 0, "max": 10000000000},
        "growth_rate": {"min": -1.0, "max": 10.0},
        "profit_margin": {"min": -1.0, "max": 1.0},
        "employees": {"min": 1, "max": 100000}
      }
    },
    "analysis_validation": {
      "consistency_checks": ["financial_ratios", "growth_vs_margin", "team_vs_revenue"],
      "cross_validation": ["multiple_sources", "historical_comparison", "industry_benchmark"],
      "outlier_detection": {"statistical_method": "iqr", "threshold": 1.5}
    }
  },

  "output_settings": {
    "report_formats": ["markdown", "json", "pdf"],
    "include_sections": [
      "executive_summary",
      "company_overview",
      "financial_analysis",
      "competitive_analysis",
      "risk_assessment",
      "investment_recommendation",
      "appendix"
    ],
    "visualization": {
      "include_charts": true,
      "chart_types": ["revenue_growth", "margin_trend", "market_share", "risk_matrix"],
      "color_scheme": "professional"
    },
    "language": "zh-CN",
    "currency": "CNY"
  },

