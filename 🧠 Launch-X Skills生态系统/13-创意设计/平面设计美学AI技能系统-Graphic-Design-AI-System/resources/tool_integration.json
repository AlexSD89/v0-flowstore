    "generation_pipeline": {
      "input_processing": {
        "requirements_extraction": "从需求描述中提取关键信息",
        "context_analysis": "分析设计上下文和约束条件",
        "brand_guidelines": "应用品牌视觉识别规范"
      },
      "ai_generation": {
        "prompt_engineering": "优化AI工具的提示词",
        "model_selection": "选择合适的AI模型",
        "parameter_tuning": "调整生成参数以获得最佳效果"
      },
      "post_processing": {
        "quality_assessment": "评估生成内容的质量",
        "format_conversion": "转换到需要的文件格式",
        "fine_tuning": "手动微调和细节优化"
      }
    }
  },
  "integration_apis": {
    "adobe_creative_cloud": {
      "authentication": "OAuth 2.0",
      "base_url": "https://cc-api.adobe.io/api/v1",
      "endpoints": {
        "files": "/files",
        "folders": "/folders",
        "assets": "/assets",
        "libraries": "/libraries"
      },
      "webhooks": ["file_created", "file_updated", "file_deleted"]
    },
    "figma": {
      "authentication": "OAuth 2.0",
      "base_url": "https://api.figma.com/v1",
      "endpoints": {
        "files": "/files/{file_id}",
        "images": "/images/{file_id}",
        "comments": "/files/{file_id}/comments"
      },
      "webhooks": ["file_update", "comment_added"]
    },
    "midjourney": {
      "authentication": "Discord Bot Token",
      "base_url": "https://discord.com/api/v10",
      "interaction_type": "slash_commands",
      "command_prefix": "/imagine"
    }
  }
}