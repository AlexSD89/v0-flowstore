  "progressiveDisclosureSettings": {
    "tokenThresholds": {
      "warning": 3000,
      "critical": 5000,
      "maximum": 8000
    },
    "loadingStrategy": {
      "eagerLoading": ["business-decision-support", "project-architect", "technical-design-expert"],
      "lazyLoading": ["enterprise-research-analyst", "market-intelligence-expert", "knowledge-master"],
      "onDemandOnly": ["gate-os-enterprise-expert", "deep-learning-expert", "cognitive-strategy-master"]
    },
    "levelManifest": {
      "Level 1": {
        "name": "核心技能包 - Reddit指南推荐",
        "skills": ["business-decision-support", "project-architect", "technical-design-expert"],
        "maxTokens": 2000,
        "autoLoad": true,
        "description": "最常用的基础技能，符合Reddit指南工程化优先原则"
      },
      "Level 2": {
        "name": "专业扩展包 - 按需智能加载",
        "skills": ["enterprise-research-analyst", "market-intelligence-expert", "knowledge-master"],
        "maxTokens": 3000,
        "autoLoad": false,
        "description": "专业分析技能，基于上下文智能识别加载"
      },
      "Level 3": {
        "name": "高级专家包 - 复杂任务专用",
        "skills": ["gate-os-enterprise-expert", "deep-learning-expert", "cognitive-strategy-master"],
        "maxTokens": 5000,
        "autoLoad": false,
        "description": "高级系统级技能，复杂任务自动识别加载"
      }
    },
    "cachingRules": {
      "enableFileCache": true,
      "cacheExpiration": 3600000,
      "maxCacheSize": "100MB",
      "enableMemoryCache": true
    },
    "contextAwareness": {
      "enableSessionMemory": true,
      "enableProjectContext": true,
      "enableUserPreferences": true,
      "enableAdaptiveLoading": true
    }
  },

  "performanceOptimizations": {
    "enableContentSummarization": true,
    "enableSmartFiltering": true,
    "enableDependencyOptimization": true,
    "enableBatchProcessing": true,
    "maxConcurrentLoads": 3,
    "enableProgressiveLoading": true
  },

  "monitoringSettings": {
    "enableUsageTracking": true,
    "enablePerformanceMonitoring": true,
    "enableErrorTracking": true,
    "enableUserFeedback": true,
    "logDirectory": "./logs/skills",
    "metricsRetention": 30
  },

  "qualityGates": {
    "enableContentValidation": true,
    "enableStructureValidation": true,
    "enablePerformanceValidation": true,
    "maxLoadingTime": 5000,
    "maxMemoryUsage": "256MB",
    "minSuccessRate": 0.95
  }
