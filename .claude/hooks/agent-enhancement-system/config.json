  "taskComplexityAssessment": {
    "indicators": {
      "domainSpecificity": {
        "weight": 0.25,
        "indicators": ["专业术语", "行业概念", "技术深度"],
        "threshold": 0.6
      },
      "dataComplexity": {
        "weight": 0.20,
        "indicators": ["数据量", "数据类型", "处理难度"],
        "threshold": 0.5
      },
      "collaborationNeeds": {
        "weight": 0.20,
        "indicators": ["协作需求", "团队规模", "沟通复杂度"],
        "threshold": 0.7
      },
      "timeCriticality": {
        "weight": 0.15,
        "indicators": ["紧急程度", "时间压力", "截止日期"],
        "threshold": 0.8
      },
      "uncertaintyLevel": {
        "weight": 0.20,
        "indicators": ["信息不完整", "需求模糊", "风险因素"],
        "threshold": 0.6
      }
    },
    "schedulingStrategy": {
      "simple": {
        "threshold": "< 0.3",
        "approach": "单Agent处理",
        "recommendedAgents": 1
      },
      "moderate": {
        "threshold": "0.3 - 0.6",
        "approach": "主从协作模式",
        "recommendedAgents": "2-3"
      },
      "complex": {
        "threshold": "≥ 0.6",
        "approach": "多Agent并行或链式协作",
        "recommendedAgents": "3-5"
      }
    }
  },
  "performanceOptimization": {
    "tokenEfficiency": {
