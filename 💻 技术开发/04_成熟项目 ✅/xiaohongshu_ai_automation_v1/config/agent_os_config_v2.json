{
  "system": {
    "name": "LaunchX Agent OS System v2.0",
    "version": "2.0.0",
    "description": "基于BMAD混合智能架构的智能业务战略平台",
    "debug_mode": false,
    "log_level": "INFO",
    "max_concurrent_requests": 100,
    "request_timeout": 30000,
    "health_check_interval": 60
  },
  "layer1": {
    "name": "核心交互逻辑层",
    "description": "处理用户输入、意图分析、动态路由和状态同步",
    "context_ttl": 3600,
    "intent_confidence_threshold": 0.7,
    "routing_strategy": "intelligent",
    "state_sync_enabled": true,
    "max_context_size": 10000,
    "intent_classification_model": "advanced",
    "routing_rules": {
      "investment_analysis": ["investment", "分析", "评估", "投资"],
      "market_research": ["市场", "研究", "趋势", "行业"],
      "business_strategy": ["策略", "方案", "建议", "转型"],
      "technical_consulting": ["技术", "开发", "实现", "系统"],
      "customer_service": ["客服", "支持", "帮助", "问题"]
    }
  },
  "layer2": {
    "name": "学习进化逻辑层",
    "description": "行为模式分析、知识图谱管理、个性化推荐",
    "learning_rate": 0.1,
    "knowledge_update_interval": 300,
    "personalization_enabled": true,
    "pattern_recognition_window": 50,
    "knowledge_graph_max_nodes": 10000,
    "recommendation_confidence_threshold": 0.6,
    "behavior_model_type": "collaborative_filtering",
    "knowledge_sources": [
      "user_interactions",
      "external_data",
      "domain_expertise",
      "historical_patterns"
    ]
  },
  "layer3": {
    "name": "协作决策逻辑层",
    "description": "人机边界管理、质量门控、决策引擎",
    "decision_timeout": 30,
    "human_intervention_threshold": 0.3,
    "quality_gates_enabled": true,
    "decision_engine_type": "hybrid_intelligent",
    "boundary_management": {
      "auto_decision_threshold": 0.8,
      "human_required_threshold": 0.3,
      "collaboration_modes": ["auto", "assisted", "human_led"]
    },
    "quality_gates": {
      "data_quality_gate": 0.7,
      "logic_consistency_gate": 0.8,
      "business_value_gate": 0.6,
      "risk_assessment_gate": 0.7
    }
  },
  "layer4": {
    "name": "数据持久化层",
    "description": "数据生命周期管理、价值评估、智能存储",
    "data_retention_days": 90,
    "backup_enabled": true,
    "compression_enabled": true,
    "storage_strategy": "intelligent",
    "data_lifecycle": {
      "active_retention": 30,
      "archive_retention": 180,
      "cold_storage_retention": 365
    },
    "value_assessment": {
      "business_value_weight": 0.4,
      "technical_value_weight": 0.3,
      "strategic_value_weight": 0.3
    },
    "storage_policies": {
      "high_value_data": "hot_storage",
      "medium_value_data": "warm_storage",
      "low_value_data": "cold_storage"
    }
  },
  "customer_intelligence": {
    "name": "客户智能分析引擎",
    "description": "客户需求分析、市场机会识别、个性化推荐",
    "segmentation_enabled": true,
    "market_analysis_enabled": true,
    "recommendation_engine_enabled": true,
    "customer_segments": {
      "individual": {
        "description": "个人用户",
        "characteristics": ["small_scale", "price_sensitive", "ease_of_use"],
        "services": ["basic_analysis", "template_solutions"]
      },
      "small_business": {
        "description": "小企业",
        "characteristics": ["growth_oriented", "cost_conscious", "quick_implementation"],
        "services": ["growth_strategies", "cost_optimization", "quick_wins"]
      },
      "medium_enterprise": {
        "description": "中型企业",
        "characteristics": ["professional", "scalable", "integrated_solutions"],
        "services": ["comprehensive_analysis", "strategic_planning", "integration_support"]
      },
      "large_enterprise": {
        "description": "大型企业",
        "characteristics": ["enterprise_grade", "security_focused", "custom_solutions"],
        "services": ["enterprise_consulting", "custom_development", "ongoing_support"]
      }
    },
    "requirement_categories": {
      "content_creation": {
        "description": "内容创作需求",
        "priority": "medium",
        "complexity": "low"
      },
      "data_analytics": {
        "description": "数据分析需求",
        "priority": "high",
        "complexity": "high"
      },
      "customer_service": {
        "description": "客户服务需求",
        "priority": "high",
        "complexity": "medium"
      },
      "business_intelligence": {
        "description": "商业智能需求",
        "priority": "high",
        "complexity": "high"
      },
      "automation": {
        "description": "自动化需求",
        "priority": "medium",
        "complexity": "medium"
      }
    },
    "market_analysis": {
      "trend_analysis_enabled": true,
      "competitor_analysis_enabled": true,
      "opportunity_scoring_enabled": true,
      "data_sources": [
        "market_reports",
        "industry_analysis",
        "competitor_data",
        "trend_indicators"
      ]
    }
  },
  "integration": {
    "mcp_servers": {
      "tavily_search": {
        "enabled": true,
        "priority": "high",
        "timeout": 10000
      },
      "workspace_filesystem": {
        "enabled": true,
        "priority": "high",
        "timeout": 5000
      },
      "python_sandbox": {
        "enabled": true,
        "priority": "medium",
        "timeout": 30000
      }
    },
    "external_apis": {
      "notification_service": {
        "enabled": false,
        "endpoint": "",
        "api_key": ""
      },
      "analytics_service": {
        "enabled": false,
        "endpoint": "",
        "api_key": ""
      }
    }
  },
  "monitoring": {
    "enabled": true,
    "metrics_collection": true,
    "performance_monitoring": true,
    "error_tracking": true,
    "log_retention_days": 30,
    "alert_thresholds": {
      "error_rate": 0.05,
      "response_time_ms": 5000,
      "memory_usage": 0.8,
      "cpu_usage": 0.8
    }
  },
  "security": {
    "encryption_enabled": true,
    "data_anonymization": true,
    "access_control": true,
    "audit_logging": true,
    "security_policies": {
      "data_classification": "public_sensitive_private",
      "access_levels": ["guest", "user", "admin"],
      "session_timeout": 3600
    }
  },
  "performance": {
    "caching_enabled": true,
    "cache_ttl": 300,
    "connection_pool_size": 20,
    "max_concurrent_processes": 50,
    "optimization_level": "balanced",
    "resource_limits": {
      "memory_mb": 2048,
      "cpu_cores": 4,
      "disk_space_gb": 100
    }
  },
  "development": {
    "debug_mode": false,
    "mock_external_services": false,
    "enable_detailed_logging": false,
    "test_mode": false,
    "development_features": {
      "execution_trace": true,
      "performance_profiling": false,
      "component_isolation": false
    }
  }
}