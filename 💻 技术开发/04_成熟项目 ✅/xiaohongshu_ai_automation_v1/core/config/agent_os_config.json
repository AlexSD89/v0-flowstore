{
  "system": {
    "name": "LaunchX v4.0 Agent OS",
    "version": "4.0.0",
    "environment": "production",
    "debug": false,
    "log_level": "INFO"
  },
  "database": {
    "type": "sqlite",
    "path": "./data/agent_os.db",
    "backup_enabled": true,
    "backup_interval": 3600
  },
  "agents": {
    "max_concurrent_agents": 10,
    "default_timeout": 300,
    "retry_attempts": 3,
    "retry_delay": 5,
    "heartbeat_interval": 30,
    "auto_recovery": true
  },
  "collaboration": {
    "max_concurrent_collaborations": 10,
    "synergy_threshold": 0.7,
    "collaboration_timeout": 600,
    "enable_cross_agent_learning": true
  },
  "scheduling": {
    "max_concurrent_tasks": 50,
    "scheduling_horizon": 24,
    "priority_levels": 5,
    "load_balancing_strategy": "round_robin",
    "task_timeout": 1800
  },
  "learning": {
    "learning_enabled": true,
    "learning_rate": 0.01,
    "optimization_interval": 3600,
    "feedback_retention_days": 30,
    "model_update_threshold": 100,
    "enable_continuous_learning": true
  },
  "monitoring": {
    "collection_interval": 60,
    "alert_evaluation_interval": 300,
    "insight_generation_interval": 3600,
    "dashboard_refresh_interval": 30,
    "metrics_retention_days": 7,
    "alert_retention_days": 30,
    "enable_real_time_monitoring": true
  },
  "xiaohongshu": {
    "platform_config": {
      "base_url": "https://www.xiaohongshu.com",
      "api_version": "v2",
      "request_timeout": 30,
      "rate_limit": {
        "requests_per_minute": 100,
        "burst_limit": 20
      }
    },
    "content_analysis": {
      "viral_content_threshold": 0.05,
      "engagement_rate_threshold": 0.03,
      "content_quality_threshold": 0.80,
      "trend_prediction_window": 7,
      "brand_matching_accuracy": 0.95
    },
    "ai_algorithms": {
      "viral_detection": {
        "model_path": "./models/viral_content_v1.pkl",
        "accuracy_target": 0.95,
        "confidence_threshold": 0.8
      },
      "trend_prediction": {
        "model_path": "./models/trend_prediction_v1.pkl",
        "accuracy_target": 0.90,
        "prediction_horizon": 7
      },
      "brand_matching": {
        "model_path": "./models/brand_matching_v1.pkl",
        "accuracy_target": 0.95,
        "embedding_dimension": 768
      },
      "engagement_optimization": {
        "model_path": "./models/engagement_optimizer_v1.pkl",
        "improvement_target": 2.0,
        "optimization_goals": ["likes", "comments", "shares"]
      }
    }
  },
  "performance": {
    "cache_enabled": true,
    "cache_ttl": 300,
    "connection_pool_size": 20,
    "max_memory_usage": "2GB",
    "cpu_usage_threshold": 80,
    "memory_usage_threshold": 85
  },
  "security": {
    "encryption_enabled": true,
    "api_key_required": true,
    "rate_limiting_enabled": true,
    "audit_logging": true,
    "data_retention_policy": {
      "user_data": 365,
      "system_logs": 30,
      "analytics_data": 90
    }
  },
  "notifications": {
    "email": {
      "enabled": false,
      "smtp_server": "",
      "smtp_port": 587,
      "sender_address": "",
      "recipients": []
    },
    "webhook": {
      "enabled": false,
      "url": "",
      "timeout": 30,
      "retry_count": 3
    },
    "slack": {
      "enabled": false,
      "webhook_url": "",
      "channel": "#monitoring"
    }
  },
  "experimental_features": {
    "enable_beta_algorithms": false,
    "enable_advanced_analytics": true,
    "enable_ml_auto_tuning": false,
    "enable_distributed_processing": false
  }
}